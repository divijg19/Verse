package templ

templ Layout(surface string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Verse</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/htmx.min.js"></script>
			<style>
	:root {
		color-scheme: dark;
	}

	html {
		background: rgb(10 10 10);
	}

		body {
			background:
				radial-gradient(circle at top, rgba(168, 85, 247, 0.14) 0%, rgba(10, 10, 10, 0) 32%),
				linear-gradient(180deg, rgba(23, 23, 23, 0.88) 0%, rgba(10, 10, 10, 0.98) 72%);
			overflow-x: hidden;
		}

		.verse-app-shell {
			position: relative;
			isolation: isolate;
			display: flex;
			flex-direction: column;
			width: 100%;
			height: 100%;
			min-width: 0;
			min-height: 0;
		}

	.verse-app-shell::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at top left, rgba(88, 28, 135, 0.18) 0%, rgba(10, 10, 10, 0) 34%),
			radial-gradient(circle at bottom right, rgba(38, 38, 38, 0.3) 0%, rgba(10, 10, 10, 0) 36%);
		pointer-events: none;
		z-index: 0;
	}

		#screen {
			position: relative;
			z-index: 1;
			flex: 1;
			min-width: 0;
			min-height: 0;
		}

		.verse-app-shell[data-editor-overlay-active="true"] #screen {
			z-index: 120;
		}

		.verse-screen-frame {
			margin: 0 auto;
			width: 100%;
			max-width: 100%;
			min-height: 0;
		}

	.verse-screen-frame--standard {
		max-width: 60rem;
	}

		.verse-screen-frame--wide {
			max-width: 82rem;
		}

		.verse-surface-shell {
			display: flex;
			height: 100%;
			min-height: 0;
			flex-direction: column;
			gap: 1.5rem;
			padding-top: var(--verse-surface-top-space, clamp(7rem, 16vh, 9rem));
		}

		.verse-surface-heading {
			font-family: Georgia, Cambria, "Times New Roman", Times, serif;
			font-size: 2rem;
			line-height: 1;
			color: rgb(229 229 229);
			overflow-wrap: anywhere;
		}

		.verse-surface-body {
			min-width: 0;
			min-height: 0;
			flex: 1;
		}

		.verse-panel {
			border: 1px solid rgb(38 38 38);
			border-radius: 1.5rem;
			min-width: 0;
			background: linear-gradient(180deg, rgba(23, 23, 23, 0.82) 0%, rgba(10, 10, 10, 0.5) 100%);
			box-shadow:
			0 24px 80px rgba(0, 0, 0, 0.24),
			inset 0 1px 0 rgba(115, 115, 115, 0.1);
		}

		.verse-panel-soft {
			border: 1px solid rgb(23, 23, 23);
			border-radius: 1.25rem;
			min-width: 0;
			background: linear-gradient(180deg, rgba(23, 23, 23, 0.54) 0%, rgba(10, 10, 10, 0.24) 100%);
			box-shadow: inset 0 1px 0 rgba(82, 82, 82, 0.12);
		}

		.verse-eyebrow {
			font-size: 0.62rem;
			letter-spacing: 0.22em;
			text-transform: uppercase;
			color: rgb(115 115 115);
		}

		.verse-body-copy {
			font-size: 0.98rem;
			line-height: 1.75;
			color: rgb(163 163 163);
		}

		.verse-mobile-screen-title,
		.verse-mobile-screen-title-wrap,
		.verse-mobile-copy-trim {
			min-width: 0;
		}

		.verse-button,
		.verse-button-secondary,
		.verse-button-ghost,
		.verse-button-danger {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 0.45rem;
			min-width: 8.5rem;
			min-height: 2.625rem;
			max-width: 100%;
			padding: 0.5rem 1rem;
			border-radius: 0.375rem;
			font-size: 1rem;
			text-decoration: none;
			text-align: center;
			line-height: 1.2;
			white-space: normal;
			border: 1px solid transparent;
			cursor: pointer;
			transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 150ms ease;
		}

		.verse-button {
			background: rgb(147 51 234);
			color: rgb(250 245 255);
		}

		.verse-button:hover {
			background: rgb(168 85 247);
		}

		.verse-button-secondary {
			border: 1px solid rgb(64 64 64);
			background: rgba(23, 23, 23, 0.72);
			color: rgb(229 229 229);
		}

		.verse-button-secondary:hover {
			border-color: rgb(115 115 115);
			background: rgba(38, 38, 38, 0.9);
		}

		.verse-button-ghost {
			border: 1px solid rgba(38, 38, 38, 0.72);
			background: transparent;
			color: rgb(163 163 163);
		}

		.verse-button-ghost:hover {
			border-color: rgb(82 82 82);
			color: rgb(229 229 229);
		}

		.verse-button-danger {
			border-color: rgba(127, 29, 29, 0.72);
			background: rgba(69, 10, 10, 0.32);
			color: rgb(252 165 165);
		}

		.verse-button-danger:hover {
			border-color: rgba(185, 28, 28, 0.82);
			background: rgba(127, 29, 29, 0.4);
			color: rgb(254 202 202);
		}

		/* Masthead */
		.verse-masthead {
			position: relative;
			z-index: 30;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			padding: 0.7rem 1.5rem;
			border-bottom: 1px solid rgb(38 38 38);
			background: rgba(10, 10, 10, 0.82);
			backdrop-filter: blur(10px);
		}

		.verse-masthead-brand {
			font-family: Georgia, Cambria, "Times New Roman", Times, serif;
			font-size: 1rem;
			line-height: 1;
			color: rgb(245 245 245);
			text-decoration: none;
			letter-spacing: 0.02em;
		}

		.verse-masthead-nav {
			display: flex;
			align-items: center;
			gap: 0.25rem;
		}

		.verse-masthead-link {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-height: 2.25rem;
			padding: 0.45rem 0.85rem;
			border-radius: 0.5rem;
			color: rgb(163 163 163);
			font-size: 0.82rem;
			letter-spacing: 0.04em;
			text-decoration: none;
			transition: background-color 150ms ease, color 150ms ease;
		}

		.verse-masthead-link:hover {
			background: rgba(38, 38, 38, 0.72);
			color: rgb(245 245 245);
		}

		.verse-masthead-link[data-active="true"] {
			background: rgba(76, 29, 149, 0.28);
			color: rgb(229 229 229);
		}

		.verse-masthead-actions {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		.verse-masthead-actions .verse-signout-button {
			min-height: 2.25rem;
			padding: 0.45rem 0.85rem;
			border-radius: 0.5rem;
			font-size: 0.72rem;
			letter-spacing: 0.16em;
			text-transform: uppercase;
		}

		#mobile-nav {
			position: fixed;
			inset: 0;
			z-index: 80;
			display: none;
			pointer-events: none;
		}

		.verse-mobile-nav-bar {
			position: fixed;
			top: 0;
			right: 0;
			left: 0;
			padding: calc(env(safe-area-inset-top) + 0.65rem) 0.9rem 0;
			pointer-events: none;
		}

		.verse-mobile-nav-bar-inner {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			max-width: 82rem;
			margin: 0 auto;
			padding: 0.55rem 0.8rem;
			border: 1px solid rgba(38, 38, 38, 0.92);
			border-radius: 0.875rem;
			background: rgba(15, 15, 15, 0.82);
			box-shadow: inset 0 1px 0 rgba(115, 115, 115, 0.06);
			backdrop-filter: blur(10px);
			pointer-events: auto;
		}

		.verse-mobile-brand {
			font-family: Georgia, Cambria, "Times New Roman", Times, serif;
			font-size: 1.05rem;
			line-height: 1;
			color: rgb(245 245 245);
			text-decoration: none;
		}

		.verse-mobile-nav-toggle {
			display: inline-flex;
			flex-direction: column;
			justify-content: center;
			gap: 0.28rem;
			width: 2.75rem;
			height: 2.75rem;
			padding: 0 0.75rem;
			border: 1px solid rgba(64, 64, 64, 0.92);
			border-radius: 0.875rem;
			background: rgba(15, 15, 15, 0.82);
			color: rgb(229 229 229);
			box-shadow: inset 0 1px 0 rgba(115, 115, 115, 0.06);
		}

		.verse-mobile-nav-toggle span {
			display: block;
			width: 100%;
			height: 2px;
			border-radius: 999px;
			background: currentColor;
		}

		.verse-mobile-nav-sheet[hidden] {
			display: none;
		}

		.verse-mobile-nav-sheet {
			position: fixed;
			inset: 0;
			pointer-events: auto;
		}

		.verse-mobile-nav-backdrop {
			position: absolute;
			inset: 0;
			background:
				radial-gradient(circle at top, rgba(168, 85, 247, 0.08) 0%, rgba(10, 10, 10, 0) 30%),
				rgba(10, 10, 10, 0.38);
			backdrop-filter: blur(4px);
		}

		.verse-mobile-nav-panel {
			position: absolute;
			top: calc(env(safe-area-inset-top) + 3.35rem);
			right: 0.75rem;
			width: min(19rem, calc(100vw - 1.5rem));
			max-height: min(22rem, calc(100svh - env(safe-area-inset-top) - 4.5rem));
			padding: 0.45rem;
			border: 1px solid rgba(38, 38, 38, 0.92);
			border-radius: 1rem;
			background: linear-gradient(180deg, rgba(18, 18, 18, 0.96) 0%, rgba(10, 10, 10, 0.98) 100%);
			box-shadow:
			0 24px 70px rgba(0, 0, 0, 0.34),
			inset 0 1px 0 rgba(115, 115, 115, 0.06);
			overflow-y: auto;
		}

		.verse-mobile-nav-list {
			display: grid;
			gap: 0.35rem;
		}

		.verse-mobile-nav-link {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			min-height: 2.85rem;
			padding: 0.75rem 0.9rem;
			border: 1px solid rgb(38 38 38);
			border-radius: 0.9rem;
			background: linear-gradient(180deg, rgba(23, 23, 23, 0.72) 0%, rgba(10, 10, 10, 0.28) 100%);
			text-decoration: none;
			transition: border-color 150ms ease, background-color 150ms ease, transform 150ms ease, color 150ms ease;
		}

		.verse-mobile-nav-link:hover {
			border-color: rgb(82 82 82);
			background: linear-gradient(180deg, rgba(31, 31, 31, 0.88) 0%, rgba(10, 10, 10, 0.4) 100%);
		}

		.verse-mobile-nav-link[data-active="true"] {
			border-color: rgba(168, 85, 247, 0.52);
			background: linear-gradient(180deg, rgba(76, 29, 149, 0.3) 0%, rgba(10, 10, 10, 0.42) 100%);
			box-shadow: inset 0 1px 0 rgba(216, 180, 254, 0.08);
		}

		.verse-mobile-nav-link-copy {
			display: flex;
			align-items: center;
			min-width: 0;
		}

		.verse-mobile-nav-link-copy strong {
			font-size: 0.98rem;
			line-height: 1.2;
			color: rgb(245 245 245);
			overflow-wrap: anywhere;
		}

		.verse-mobile-nav-actions {
			display: grid;
			gap: 0.5rem;
			margin-top: 0.85rem;
			padding-top: 0.85rem;
			border-top: 1px solid rgb(38 38 38);
		}

		.verse-signout-form {
			display: flex;
			margin: 0;
		}

		.verse-signout-button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 100%;
			min-height: 2.85rem;
			padding: 0.75rem 0.9rem;
			border: 1px solid rgb(38 38 38);
			border-radius: 0.9rem;
			background: linear-gradient(180deg, rgba(23, 23, 23, 0.72) 0%, rgba(10, 10, 10, 0.28) 100%);
			color: rgb(212 212 212);
			font-size: 0.98rem;
			line-height: 1.2;
			cursor: pointer;
			transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
		}

		.verse-signout-button:hover {
			border-color: rgb(82 82 82);
			background: linear-gradient(180deg, rgba(31, 31, 31, 0.88) 0%, rgba(10, 10, 10, 0.4) 100%);
			color: rgb(245 245 245);
		}

		.verse-signout-button:focus-visible {
			outline: none;
			box-shadow: 0 0 0 2px rgb(212 212 212);
		}

		@media (max-width: 1023px) {
			.verse-masthead {
				display: none;
			}

			#mobile-nav {
				display: block;
			}

			#screen {
				overflow-x: hidden;
				overflow-y: auto;
				padding: calc(env(safe-area-inset-top) + 4rem) 0.85rem calc(env(safe-area-inset-bottom) + 1.25rem);
			}

		.verse-screen-frame {
			height: auto;
			min-height: calc(100svh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 4.75rem);
		}

		.verse-surface-shell {
			height: auto;
			gap: 0.85rem;
			padding-top: 0.15rem;
		}

		.verse-surface-heading {
			font-size: 1.9rem;
			line-height: 1.05;
		}

		.verse-mobile-screen-title,
		.verse-mobile-screen-title-wrap {
			position: absolute !important;
			width: 1px !important;
			height: 1px !important;
			padding: 0 !important;
			margin: -1px !important;
			overflow: hidden !important;
			clip: rect(0, 0, 0, 0) !important;
			clip-path: inset(50%) !important;
			white-space: nowrap !important;
			border: 0 !important;
		}

		.verse-mobile-copy-trim {
			display: none !important;
		}

		.verse-panel,
			.verse-panel-soft {
				border-radius: 1.2rem;
			}
		}

		@media (max-width: 479px) {
			.verse-mobile-nav-bar {
				padding-right: 0.7rem;
				padding-left: 0.7rem;
			}

			.verse-mobile-nav-bar-inner {
				gap: 0.75rem;
			}

			.verse-mobile-nav-panel {
				top: calc(env(safe-area-inset-top) + 3.2rem);
				width: calc(100vw - 1rem);
				right: 0.5rem;
			}
		}

		@media (min-width: 1024px) {
			.verse-app-shell {
				--verse-surface-top-space: clamp(2.5rem, 5vh, 4rem);
			}

			#screen {
				overflow: hidden;
				padding: 0 1.5rem;
			}
		}

		@media (min-width: 1280px) {
			.verse-app-shell {
				--verse-surface-top-space: clamp(2.75rem, 5vh, 4.25rem);
			}

			#screen {
				padding-right: 2.25rem;
				padding-left: 2.25rem;
			}
		}
	</style>
		</head>
		<body class="bg-neutral-950 text-neutral-200 h-screen overflow-hidden">
			<div id="viewport" class="verse-app-shell h-screen overflow-hidden">
				@Nav(surface)
				@If(surface == "library") {
					<div id="screen" class="verse-screen-frame verse-screen-frame--wide transition-all duration-300 ease-out">
						@content
					</div>
				}
				@If(surface != "library") {
					<div id="screen" class="verse-screen-frame verse-screen-frame--standard transition-all duration-200 ease-out">
						@content
					</div>
				}
			</div>
			<script src="/static/js/navigation.js"></script>
		</body>
	</html>
}
