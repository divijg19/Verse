package templ

import "context"

templ PoemViewScreen(ctx context.Context, poem PoemView) {
	@Screen("Poem", PoemViewContent(ctx, poem))
}

templ PoemViewContent(ctx context.Context, poem PoemView) {
	<div class="space-y-5">
		<style>
				.verse-poem-view-card {
					min-width: 0;
					padding: 1.25rem 1.25rem 1.1rem;
				}

				.verse-poem-view-actions {
					display: flex;
					align-items: center;
					justify-content: space-between;
					min-width: 0;
					gap: 0.9rem;
					flex-wrap: wrap;
				}

				.verse-poem-view-nav {
					display: inline-flex;
					align-items: center;
					flex-wrap: wrap;
					gap: 0.55rem;
					font-size: 0.68rem;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: rgb(163 163 163);
				text-decoration: none;
				transition: color 150ms ease;
			}

			.verse-poem-view-nav:hover {
				color: rgb(229 229 229);
			}

			.verse-poem-view-publication {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				flex-wrap: wrap;
			}

			.verse-poem-view-publication-state {
				display: flex;
				align-items: baseline;
				gap: 0.65rem;
				margin: 0;
				font-size: 0.62rem;
				letter-spacing: 0.18em;
				text-transform: uppercase;
			}

			.verse-poem-view-publication-badge {
				color: rgb(163 163 163);
			}

			.verse-poem-view-publication-badge--draft {
				color: rgb(115 115 115);
			}

			.verse-poem-view-publication-when {
				color: rgb(115 115 115);
			}

			.verse-poem-view-publication-form {
				display: flex;
				margin: 0;
			}

				.verse-poem-view-article {
					padding-top: 1.1rem;
					font-size: 1.08rem;
					line-height: 1.95;
					color: rgb(245 245 245);
					overflow-wrap: anywhere;
				}

			@media (max-width: 639px) {
				.verse-poem-view-card {
					padding: 1rem;
				}

				.verse-poem-view-actions {
					flex-direction: column;
					align-items: flex-start;
				}
			}
		</style>
		<div class="verse-poem-view-card verse-panel">
			<div class="verse-poem-view-actions">
				<a
					href="/library"
					hx-get="/library"
					hx-target="#screen"
					hx-swap="innerHTML"
					class="verse-poem-view-nav"
				>◀ Library</a>
				<a
					href={ "/poem/" + poem.ID + "/history" }
					hx-get={ "/poem/" + poem.ID + "/history" }
					hx-target="#screen"
					hx-swap="innerHTML"
					class="verse-poem-view-nav"
				>History</a>
				<a
					href={ "/editor/" + poem.ID }
					hx-get={ "/editor/" + poem.ID }
					hx-target="#screen"
					hx-swap="innerHTML"
					class="verse-poem-view-nav"
				>Editor ▶</a>
			</div>
			<p class="pt-5 text-[0.62rem] uppercase tracking-[0.18em] text-neutral-500">{ poem.CreatedAt.UTC().Format("Jan 2, 2006 15:04 UTC") }</p>
			<article class="verse-poem-view-article whitespace-pre-wrap">{ poem.Content }</article>
		</div>
		<div class="verse-poem-view-publication">
			<p class="verse-poem-view-publication-state">
				if poem.Published {
					<span class="verse-poem-view-publication-badge">Published</span>
					if poem.PublishedAt != nil {
						<span class="verse-poem-view-publication-when">since { poem.PublishedAt.UTC().Format("Jan 2, 2006") }</span>
					}
				} else {
					<span class="verse-poem-view-publication-badge verse-poem-view-publication-badge--draft">Draft</span>
					<span class="verse-poem-view-publication-when">not on the public site</span>
				}
			</p>
			<form
				hx-post="/poem/publish"
				hx-target="#screen"
				hx-swap="innerHTML"
				class="verse-poem-view-publication-form"
			>
				<input type="hidden" name="id" value={ poem.ID }/>
				<input type="hidden" name="publish" value={ poem.PublishAction() }/>
				@CSRFField(ctx)
				<button
					type="submit"
					class={ poem.PublishButtonClass() }
				>
					{ poem.PublishActionLabel() }
				</button>
			</form>
		</div>
		<form
			hx-post="/poem/delete"
			hx-target="#screen"
			hx-swap="innerHTML"
			hx-confirm="Delete this poem from your library?"
			class="pt-1"
		>
			<input type="hidden" name="id" value={ poem.ID }/>
			@CSRFField(ctx)
			<button
				type="submit"
				class="verse-button-danger"
			>
				Delete
			</button>
		</form>
	</div>
}
