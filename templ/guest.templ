package templ

import (
	"fmt"
	"net/url"
)

// guestBranchHref links to a branch's editable draft. The primary branch needs no query parameter.
func guestBranchHref(branch string) string {
	if branch == "primary" {
		return "/guest/edit"
	}
	return "/guest/edit?branch=" + url.QueryEscape(branch)
}

func guestSelectedAttr(selected bool) string {
	if selected {
		return "page"
	}
	return ""
}

// guestThanks is a helper so the greeting stays a single templ expression.
func guestThanks(name string) string {
	if name == "" {
		return "Thank you."
	}
	return "Thank you, " + name + "."
}

// GuestEditor is the limited editor a private link opens. It is a standalone page: no authoring
// shell, no navigation and no HTMX. Its one script is first-party and only autosaves the body; the
// plain form works without it. The holder edits one continuous body for the link and sends the
// result back as a proposal; nothing else is reachable from here.
templ GuestEditor(data GuestEditorData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ data.Title } — Verse</title>
			<meta name="robots" content="noindex, nofollow"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/guest.js" defer></script>
			<style>
				:root { color-scheme: dark; }
				html, body { min-height: 100%; }
				body {
					margin: 0;
					background:
						radial-gradient(circle at top, rgba(168, 85, 247, 0.12) 0%, rgba(10, 10, 10, 0) 38%),
						linear-gradient(180deg, rgba(23, 23, 23, 0.9) 0%, rgba(10, 10, 10, 0.98) 76%);
					color: rgb(229, 229, 229);
					font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
					padding: 1.25rem;
					box-sizing: border-box;
				}
				.verse-guest-shell {
					width: 100%;
					max-width: 62rem;
					margin: 0 auto;
				}
				.verse-guest-layout {
					display: flex;
					align-items: stretch;
					gap: 1rem;
				}
				.verse-guest-branches {
					flex: 0 0 11rem;
					display: flex;
					flex-direction: column;
					gap: 0.4rem;
					min-width: 0;
				}
				.verse-guest-main { flex: 1 1 auto; min-width: 0; }
				.verse-guest-branch {
					display: block;
					text-decoration: none;
					border: 1px solid rgb(38 38 38);
					border-radius: 0.5rem;
					background: rgba(10, 10, 10, 0.5);
					padding: 0.65rem 0.7rem;
					color: rgb(196 181 253);
					font-size: 0.78rem;
					line-height: 1.35;
					overflow-wrap: anywhere;
				}
				.verse-guest-branch:hover { border-color: rgb(82 82 82); }
				.verse-guest-branch--selected {
					border-color: rgb(168 85 247);
					background: rgba(63, 33, 101, 0.4);
					color: rgb(245 245 245);
				}
				.verse-guest-branch small {
					display: block;
					margin-top: 0.2rem;
					font-size: 0.66rem;
					color: rgb(115 115 115);
				}
				.verse-guest-card {
					border: 1px solid rgb(38, 38, 38);
					border-radius: 1.25rem;
					background: linear-gradient(180deg, rgba(23, 23, 23, 0.85) 0%, rgba(10, 10, 10, 0.6) 100%);
					box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);
					padding: 1.5rem;
					box-sizing: border-box;
				}
				.verse-guest-eyebrow {
					font-size: 0.62rem;
					letter-spacing: 0.2em;
					text-transform: uppercase;
					color: rgb(168, 85, 247);
					margin: 0 0 0.5rem;
				}
				.verse-guest-title {
					font-family: Georgia, Cambria, "Times New Roman", Times, serif;
					font-size: 1.7rem;
					line-height: 1.15;
					margin: 0 0 0.35rem;
					color: rgb(245, 245, 245);
				}
				.verse-guest-timer {
					font-size: 0.72rem;
					letter-spacing: 0.08em;
					color: rgb(163, 163, 163);
					margin: 0 0 1.25rem;
				}
				.verse-guest-label {
					display: block;
					font-size: 0.62rem;
					letter-spacing: 0.18em;
					text-transform: uppercase;
					color: rgb(115, 115, 115);
					margin: 0 0 0.5rem;
				}
				.verse-guest-name,
				.verse-guest-textarea {
					display: block;
					width: 100%;
					box-sizing: border-box;
					background: rgba(10, 10, 10, 0.65);
					border: 1px solid rgb(38, 38, 38);
					border-radius: 0.6rem;
					color: rgb(245, 245, 245);
					outline: none;
					padding: 0.75rem 0.85rem;
					transition: border-color 150ms ease, box-shadow 150ms ease;
				}
				.verse-guest-name:focus,
				.verse-guest-textarea:focus {
					border-color: rgb(115, 115, 115);
					box-shadow: inset 0 1px 0 rgba(163, 163, 163, 0.16);
				}
				.verse-guest-name { font-size: 0.95rem; margin-bottom: 1.1rem; }
				.verse-guest-textarea {
					min-height: 20rem;
					resize: vertical;
					font-family: Georgia, Cambria, "Times New Roman", Times, serif;
					font-size: 1.05rem;
					line-height: 1.65;
				}
				.verse-guest-actions {
					display: flex;
					gap: 0.5rem;
					margin-top: 1rem;
				}
				.verse-guest-submit {
					flex: 1 1 0;
					min-width: 0;
					min-height: 2.625rem;
					padding: 0.5rem;
					border: none;
					border-radius: 0.375rem;
					background: rgb(147, 51, 234);
					color: rgb(250, 245, 255);
					font-size: 1rem;
					cursor: pointer;
					transition: background-color 150ms ease;
				}
				.verse-guest-submit:hover:not(:disabled) { background: rgb(168, 85, 247); }
				.verse-guest-submit:disabled { cursor: not-allowed; opacity: 0.45; }
				.verse-guest-alternative {
					background: transparent;
					border: 1px solid rgb(63 33 101);
					color: rgb(192 132 252);
				}
				.verse-guest-alternative:hover:not(:disabled) {
					background: rgba(63, 33, 101, 0.35);
				}
				.verse-guest-status {
					min-height: 1.2rem;
					margin: 0.85rem 0 0;
					font-size: 0.7rem;
					letter-spacing: 0.06em;
					color: rgb(168 85 247);
				}
				.verse-guest-footnote {
					font-size: 0.72rem;
					line-height: 1.6;
					color: rgb(82, 82, 82);
					margin: 1.1rem 0 0;
				}
				@media (max-width: 639px) {
					.verse-guest-card { padding: 1rem; border-radius: 0.85rem; }
					.verse-guest-textarea { min-height: 16rem; }
					.verse-guest-layout { flex-direction: column; }
					.verse-guest-branches {
						flex: none;
						flex-direction: row;
						overflow-x: auto;
						padding-bottom: 0.35rem;
					}
					.verse-guest-branch { flex: 0 0 auto; max-width: 11rem; }
					.verse-guest-submit { font-size: 0.85rem; }
				}
			</style>
		</head>
		<body>
			<main class="verse-guest-shell">
				<div class="verse-guest-card">
					<p class="verse-guest-eyebrow">Private link</p>
					<h1 class="verse-guest-title">{ data.Title }</h1>
					<p class="verse-guest-timer">
						This link closes at { data.ExpiresAt.UTC().Format("Jan 2, 2006 15:04 UTC") } —
						about { fmt.Sprintf("%d", data.Minutes) } minutes from now.
					</p>
					<div class="verse-guest-layout">
						<nav class="verse-guest-branches" aria-label="Your versions" data-guest-branches>
							for _, branch := range data.Branches {
								<a
									href={ guestBranchHref(branch.Branch) }
									class={ "verse-guest-branch", templ.KV("verse-guest-branch--selected", branch.Selected) }
									data-guest-branch-tab={ branch.Branch }
									aria-current={ guestSelectedAttr(branch.Selected) }
								>
									{ branch.Label }
									<small>
										if !branch.Submitted {
											Not sent yet
										} else if branch.Changed {
											Edited since send
										} else {
											Sent
										}
									</small>
								</a>
							}
						</nav>
						<div class="verse-guest-main">
							<form
								method="post"
								action="/guest/propose"
								class="verse-guest-form"
								data-guest-changed={ fmt.Sprintf("%t", data.Changed) }
							>
								@CSRFField(ctx)
								<input type="hidden" name="submission_id" data-guest-submission value=""/>
								<input type="hidden" name="branch" data-guest-branch value={ data.Branch }/>
								<input type="hidden" name="source_branch" data-guest-source value={ data.Branch }/>
								<label class="verse-guest-label" for="guest-name">Your name (optional)</label>
								<input
									id="guest-name"
									class="verse-guest-name"
									type="text"
									name="name"
									maxlength="80"
									autocomplete="name"
									placeholder="Anonymous"
									value={ data.GuestName }
								/>
								<label class="verse-guest-label" for="guest-content">Your suggested version</label>
								<textarea
									id="guest-content"
									class="verse-guest-textarea"
									name="content"
									required
									spellcheck="true"
								>{ data.Content }</textarea>
								<p class="verse-guest-status" data-guest-status role="status" aria-live="polite">
									if data.Changed {
										Saved · ready to send
									} else {
										No changes since your last send
									}
								</p>
								<div class="verse-guest-actions">
									<button
										type="submit"
										name="branch"
										value="primary"
										data-guest-send="primary"
										class="verse-guest-submit"
										if !data.Changed {
											disabled
										}
									>Send main version</button>
									<button
										type="submit"
										name="branch"
										value="new"
										data-guest-send="alternative"
										class="verse-guest-submit verse-guest-alternative"
										if !data.Changed {
											disabled
										}
									>Send another version</button>
								</div>
							</form>
							<p class="verse-guest-footnote">
								Each version has its own draft on the left. "Send another version" keeps the
								current one and opens a new alternative beside it. Nothing is applied to the
								author's work until they choose to. This page is temporary and is not indexed.
							</p>
						</div>
					</div>
				</div>
			</main>
		</body>
	</html>
}

templ GuestProposalSent(name string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Suggestion sent — Verse</title>
			<meta name="robots" content="noindex, nofollow"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<style>
				:root { color-scheme: dark; }
				body {
					margin: 0;
					min-height: 100vh;
					background: linear-gradient(180deg, rgba(23, 23, 23, 0.9) 0%, rgba(10, 10, 10, 0.98) 76%);
					color: rgb(229, 229, 229);
					font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
					display: flex;
					align-items: center;
					justify-content: center;
					padding: 1.5rem;
					box-sizing: border-box;
				}
				.verse-guest-done {
					width: 100%;
					max-width: 26rem;
					border: 1px solid rgb(38, 38, 38);
					border-radius: 1.25rem;
					background: rgba(23, 23, 23, 0.85);
					padding: 1.75rem;
					box-sizing: border-box;
				}
				.verse-guest-done h1 {
					font-family: Georgia, Cambria, "Times New Roman", Times, serif;
					font-size: 1.6rem;
					margin: 0 0 0.75rem;
				}
				.verse-guest-done p { font-size: 0.9rem; line-height: 1.7; color: rgb(163, 163, 163); }
				.verse-guest-done .verse-guest-eyebrow {
					font-size: 0.62rem;
					letter-spacing: 0.2em;
					text-transform: uppercase;
					color: rgb(168, 85, 247);
					margin: 0 0 0.6rem;
				}
			</style>
		</head>
		<body>
			<main class="verse-guest-done">
				<p class="verse-guest-eyebrow">Suggestion sent</p>
				<h1>{ guestThanks(name) }</h1>
				<p>
					Your suggested version is with the author. It is kept separately and will not change
					the work until they choose to apply it.
				</p>
				<p><a href="/guest/edit">Back to your versions</a></p>
			</main>
		</body>
	</html>
}
