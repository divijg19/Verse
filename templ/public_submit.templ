package templ

// publicThanks keeps the greeting a single templ expression.
func publicThanks(name string) string {
	if name == "" {
		return "Thank you."
	}
	return "Thank you, " + name + "."
}

// PublicSubmit is the unauthenticated two-slide page behind a Public Link.
//
// Slide 1 is the linked work, read-only and copyable; slide 2 is the unchanged suggestion form. The
// switch is a pair of native radios with CSS sibling selectors, so it works without JavaScript. The
// one first-party bundle wires Copy Text only: it does not fetch, does not issue a session and never
// exposes the /p capability as a link.
templ PublicSubmit(title, body, token, csrf string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Send a suggestion — { title }</title>
			<meta name="robots" content="noindex, nofollow"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/public_submit.js" defer></script>
			<style>
				:root { color-scheme: dark; }
				body {
					margin: 0; min-height: 100vh; min-height: 100dvh; padding: 1.25rem; box-sizing: border-box;
					background: linear-gradient(180deg, rgba(23,23,23,0.9), rgba(10,10,10,0.98));
					color: rgb(229,229,229);
					font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
					display: flex; align-items: flex-start; justify-content: center;
				}
				.verse-public-card {
					width: 100%; max-width: 34rem; padding: 1.5rem; box-sizing: border-box;
					margin-block: auto;
					border: 1px solid rgb(38,38,38); border-radius: 1rem;
					background: rgba(23,23,23,0.85);
				}
				.verse-public-card h1 { font-family: Georgia, serif; font-size: 1.5rem; margin: 0 0 0.5rem; overflow-wrap: anywhere; }
				.verse-public-card p { font-size: 0.85rem; line-height: 1.6; color: rgb(163,163,163); }
				/* Qualified so these win over the more specific ".verse-public-card p" below. */
				.verse-public-card .verse-public-label {
					display: block; margin: 1rem 0 0.4rem; font-size: 0.62rem;
					letter-spacing: 0.18em; text-transform: uppercase; color: rgb(115,115,115);
				}
				.verse-public-switch { border: 0; padding: 0; margin: 0; min-width: 0; }
				.verse-public-radio { position: absolute; width: 1px; height: 1px; opacity: 0; margin: 0; }
				.verse-public-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; margin: 0.75rem 0 1rem; }
				.verse-public-tabs label {
					display: block; min-height: 2.75rem; padding: 0.6rem 0.5rem; box-sizing: border-box;
					border: 1px solid rgb(38,38,38); border-radius: 0.375rem; text-align: center;
					line-height: 1.3; color: rgb(163,163,163); font-size: 0.85rem; cursor: pointer;
				}
				#verse-public-read:checked ~ .verse-public-tabs label[for="verse-public-read"],
				#verse-public-write:checked ~ .verse-public-tabs label[for="verse-public-write"] {
					border-color: rgb(147,51,234); background: rgba(147,51,234,0.15); color: rgb(250,245,255);
				}
				.verse-public-panel { display: none; }
				/* The radios must stay before the tabs and panels: "~" cannot reach a preceding sibling. */
				#verse-public-read:checked ~ #verse-public-read-panel,
				#verse-public-write:checked ~ #verse-public-write-panel { display: block; }
				#verse-public-read:focus-visible ~ .verse-public-tabs label[for="verse-public-read"],
				#verse-public-write:focus-visible ~ .verse-public-tabs label[for="verse-public-write"] {
					outline: 2px solid rgb(192,132,252); outline-offset: 2px;
				}
				.verse-public-poem-body { white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.6; }
				.verse-public-actions { display: flex; gap: 0.5rem; margin-top: 1rem; }
				.verse-public-actions[hidden] { display: none; }
				.verse-public-copy {
					min-height: 2.625rem; padding: 0 0.9rem; border: 1px solid rgb(68,68,68);
					border-radius: 0.375rem; background: rgba(10,10,10,0.65);
					color: rgb(229,229,229); font-size: 0.85rem; cursor: pointer;
				}
				.verse-public-input, .verse-public-textarea {
					display: block; width: 100%; box-sizing: border-box; padding: 0.7rem 0.8rem;
					background: rgba(10,10,10,0.65); border: 1px solid rgb(38,38,38);
					border-radius: 0.5rem; color: rgb(245,245,245); font-size: 1rem;
				}
				.verse-public-input:focus-visible, .verse-public-textarea:focus-visible {
					border-color: rgb(192,132,252);
					box-shadow: 0 0 0 2px rgba(192,132,252,0.35);
				}
				.verse-public-textarea { min-height: 16rem; resize: vertical; line-height: 1.6; }
				.verse-public-submit {
					width: 100%; min-height: 2.625rem; margin-top: 1rem; border: none;
					border-radius: 0.375rem; background: rgb(147,51,234);
					color: rgb(250,245,255); font-size: 1rem; cursor: pointer;
				}
				.verse-public-card .verse-public-status { min-height: 1.2rem; color: rgb(192,132,252); }
			</style>
		</head>
		<body>
			<main class="verse-public-card">
				<p class="verse-public-label">Public link</p>
				<fieldset class="verse-public-switch">
					<legend class="verse-public-label">Choose a view</legend>
					<input type="radio" name="verse-public-view" id="verse-public-read" class="verse-public-radio" checked/>
					<input type="radio" name="verse-public-view" id="verse-public-write" class="verse-public-radio"/>
					<div class="verse-public-tabs">
						<label id="verse-public-read-label" for="verse-public-read">Read the work</label>
						<label id="verse-public-write-label" for="verse-public-write">Send a suggestion</label>
					</div>
					<section id="verse-public-read-panel" class="verse-public-panel" role="region" aria-labelledby="verse-public-read-label">
						<h1 data-copy-title>{ title }</h1>
						<div class="verse-public-poem-body" data-copy-body>{ body }</div>
						<div class="verse-public-actions" data-public-actions hidden>
							<button type="button" class="verse-public-copy" data-public-copy-text>Copy Text</button>
						</div>
						<p class="verse-public-status" role="status" aria-live="polite" data-public-copy-status></p>
						<p data-public-copy-hint>Select the text to copy it yourself if the button is unavailable.</p>
					</section>
					<section id="verse-public-write-panel" class="verse-public-panel" role="region" aria-labelledby="verse-public-write-label">
						<p>Send a suggestion to the author. Every submission is kept and reviewed separately; it is not published automatically.</p>
						<form method="post" action={ "/p/" + token + "/submit" }>
							<input type="hidden" name="csrf" value={ csrf }/>
							<label class="verse-public-label" for="public-name">Your name (optional)</label>
							<input id="public-name" class="verse-public-input" type="text" name="name" maxlength="80" placeholder="Anonymous"/>
							<label class="verse-public-label" for="public-content">Your suggestion</label>
							<textarea id="public-content" class="verse-public-textarea" name="content" required></textarea>
							<button type="submit" class="verse-public-submit">Send suggestion</button>
						</form>
					</section>
				</fieldset>
			</main>
		</body>
	</html>
}

templ PublicSubmitSent(name string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Suggestion sent — Verse</title>
			<meta name="robots" content="noindex, nofollow"/>
		</head>
		<body>
			<main class="verse-public-card">
				<p class="verse-public-label">Suggestion sent</p>
				<h1>{ publicThanks(name) }</h1>
				<p>Your text is with the author. It has not changed the published work.</p>
			</main>
		</body>
	</html>
}
