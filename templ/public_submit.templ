package templ

// publicThanks keeps the greeting a single templ expression.
func publicThanks(name string) string {
	if name == "" {
		return "Thank you."
	}
	return "Thank you, " + name + "."
}

// PublicSubmit is the unauthenticated form behind a Public Link. It has no script, no authoring
// chrome and no third-party request; every submission is appended and reviewed by the author later.
templ PublicSubmit(title, token, csrf, status string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Send a suggestion — { title }</title>
			<meta name="robots" content="noindex, nofollow"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<style>
				:root { color-scheme: dark; }
				body {
					margin: 0; min-height: 100vh; padding: 1.25rem; box-sizing: border-box;
					background: linear-gradient(180deg, rgba(23,23,23,0.9), rgba(10,10,10,0.98));
					color: rgb(229,229,229);
					font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
					display: flex; align-items: center; justify-content: center;
				}
				.verse-public-card {
					width: 100%; max-width: 34rem; padding: 1.5rem; box-sizing: border-box;
					border: 1px solid rgb(38,38,38); border-radius: 1rem;
					background: rgba(23,23,23,0.85);
				}
				.verse-public-card h1 { font-family: Georgia, serif; font-size: 1.5rem; margin: 0 0 0.5rem; }
				.verse-public-card p { font-size: 0.85rem; line-height: 1.6; color: rgb(163,163,163); }
				.verse-public-label {
					display: block; margin: 1rem 0 0.4rem; font-size: 0.62rem;
					letter-spacing: 0.18em; text-transform: uppercase; color: rgb(115,115,115);
				}
				.verse-public-input, .verse-public-textarea {
					display: block; width: 100%; box-sizing: border-box; padding: 0.7rem 0.8rem;
					background: rgba(10,10,10,0.65); border: 1px solid rgb(38,38,38);
					border-radius: 0.5rem; color: rgb(245,245,245); font-size: 1rem; outline: none;
				}
				.verse-public-textarea { min-height: 16rem; resize: vertical; line-height: 1.6; }
				.verse-public-submit {
					width: 100%; min-height: 2.625rem; margin-top: 1rem; border: none;
					border-radius: 0.375rem; background: rgb(147,51,234);
					color: rgb(250,245,255); font-size: 1rem; cursor: pointer;
				}
				.verse-public-status { min-height: 1.2rem; color: rgb(192,132,252); }
			</style>
		</head>
		<body>
			<main class="verse-public-card">
				<p class="verse-public-label">Public link</p>
				<h1>{ title }</h1>
				<p>Send a suggestion to the author. Every submission is kept and reviewed separately; it is not published automatically.</p>
				<p class="verse-public-status" role="status" aria-live="polite">{ status }</p>
				<form method="post" action={ "/p/" + token + "/submit" }>
					<input type="hidden" name="csrf" value={ csrf }/>
					<label class="verse-public-label" for="public-name">Your name (optional)</label>
					<input id="public-name" class="verse-public-input" type="text" name="name" maxlength="80" placeholder="Anonymous"/>
					<label class="verse-public-label" for="public-content">Your suggestion</label>
					<textarea id="public-content" class="verse-public-textarea" name="content" required></textarea>
					<button type="submit" class="verse-public-submit">Send suggestion</button>
				</form>
			</main>
		</body>
	</html>
}

templ PublicSubmitSent(name string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Suggestion sent — Verse</title>
			<meta name="robots" content="noindex, nofollow"/>
		</head>
		<body>
			<main class="verse-public-card">
				<p class="verse-public-label">Suggestion sent</p>
				<h1>{ publicThanks(name) }</h1>
				<p>Your text is with the author. It has not changed the published work.</p>
			</main>
		</body>
	</html>
}
