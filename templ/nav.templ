package templ

templ Nav(surface string) {
	@masthead(surface, false)
	@mobileNav(surface, false)
}

templ NavOOB(surface string) {
	@masthead(surface, true)
	@mobileNav(surface, true)
}

templ masthead(surface string, oob bool) {
	@If(oob) {
		<header id="masthead" class="verse-masthead" hx-swap-oob="outerHTML">
			@mastheadContent(surface)
		</header>
	}
	@If(!oob) {
		<header id="masthead" class="verse-masthead">
			@mastheadContent(surface)
		</header>
	}
}

templ mastheadContent(surface string) {
	<a
		href="/dashboard"
		hx-get="/dashboard"
		hx-target="#screen"
		hx-swap="innerHTML"
		class="verse-masthead-brand"
	>
		Verse
	</a>
	<nav class="verse-masthead-nav" aria-label="Primary">
		@mastheadLink(surface, "/dashboard", "Dashboard")
		@mastheadLink(surface, "/editor", "Editor")
		@mastheadLink(surface, "/library", "Library")
		@mastheadLink(surface, "/caelum", "Caelum")
		@mastheadLink(surface, "/share", "Share")
	</nav>
	<div class="verse-masthead-actions">
		@signOut()
	</div>
}

templ mastheadLink(surface string, path string, label string) {
	<a
		href={ path }
		hx-get={ path }
		hx-target="#screen"
		hx-swap="innerHTML"
		class="verse-masthead-link"
		data-masthead-link
		data-active={ navActiveValue(surface, path) }
		aria-label={ "Navigate to " + label }
	>
		{ label }
	</a>
}

templ mobileNav(surface string, oob bool) {
	@If(oob) {
		<div id="mobile-nav" hx-swap-oob="outerHTML">
			@mobileNavContent(surface)
		</div>
	}
	@If(!oob) {
		<div id="mobile-nav">
			@mobileNavContent(surface)
		</div>
	}
}

templ mobileNavContent(surface string) {
	<div class="verse-mobile-nav-bar">
		<div class="verse-mobile-nav-bar-inner">
			<a
				href="/dashboard"
				hx-get="/dashboard"
				hx-target="#screen"
				hx-swap="innerHTML"
				class="verse-mobile-brand"
			>
				Verse
			</a>
			<button
				type="button"
				data-mobile-nav-toggle
				aria-expanded="false"
				aria-controls="mobile-nav-sheet"
				aria-label="Open navigation menu"
				class="verse-mobile-nav-toggle"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
	</div>
	<div id="mobile-nav-sheet" data-mobile-nav-sheet class="verse-mobile-nav-sheet" hidden>
		<div class="verse-mobile-nav-backdrop" data-mobile-nav-close></div>
		<div class="verse-mobile-nav-panel">
			<div class="verse-mobile-nav-list">
				@mobileNavLink(surface, "/dashboard", "Dashboard")
				@mobileNavLink(surface, "/editor", "Editor")
				@mobileNavLink(surface, "/library", "Library")
				@mobileNavLink(surface, "/caelum", "Caelum")
				@mobileNavLink(surface, "/share", "Share")
			</div>
			<div class="verse-mobile-nav-actions">
				@signOut()
			</div>
		</div>
	</div>
}

// signOut ends the session.
//
// This route has been registered and working since it was written, and tests/auth_test.go has covered
// it the whole time. What was missing was any control that reached it: no form, no link, and no
// reference in a single template. The only way to end a session was to wait out the eight-hour TTL or
// clear cookies by hand, which on a shared or borrowed machine leaves the writing surface open.
//
// A plain form posting to the route, deliberately, rather than an htmx request. A sign-out that
// depends on JavaScript is a sign-out that does not work on the surface where the script did not load,
// and this release has just spent its length removing a dependence on script that was never running.
// The handler redirects to /login, and a full navigation to there is the correct outcome.
templ signOut() {
	<form method="post" action="/logout" class="verse-signout-form">
		@CSRFField(ctx)
		<button type="submit" class="verse-signout-button">Sign out</button>
	</form>
}

templ mobileNavLink(surface string, path string, label string) {
	<a
		href={ path }
		hx-get={ path }
		hx-target="#screen"
		hx-swap="innerHTML"
		data-mobile-nav-link
		data-active={ navActiveValue(surface, path) }
		aria-label={ "Navigate to " + label }
		class="verse-mobile-nav-link"
	>
		<div class="verse-mobile-nav-link-copy">
			<strong>{ label }</strong>
		</div>
	</a>
}

func navSurfaceLabel(surface string) string {
	switch surface {
	case "dashboard":
		return "Dashboard"
	case "editor":
		return "Editor"
	case "library":
		return "Library"
	case "caelum":
		return "Caelum"
	case "share":
		return "Share"
	default:
		return "Verse"
	}
}

func navSurfacePath(surface string) string {
	switch surface {
	case "dashboard":
		return "/dashboard"
	case "editor":
		return "/editor"
	case "library":
		return "/library"
	case "caelum":
		return "/caelum"
	case "share":
		return "/share"
	default:
		return "/dashboard"
	}
}

func navActiveValue(surface string, path string) string {
	if navSurfacePath(surface) == path {
		return "true"
	}
	return "false"
}
