package templ

import "fmt"

templ ShareContent(works []ShareWorkOption, publicAddressConfigured bool) {
	<div class="space-y-4">
		<style>
			.verse-share-panel {
				min-width: 0;
				padding: 1rem 1.1rem;
			}

			.verse-share-picker {
				display: flex;
				min-width: 0;
				flex-direction: column;
				gap: 0.45rem;
				padding-top: 0.85rem;
			}

			.verse-share-picker label {
				font-size: 0.62rem;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: rgb(115 115 115);
			}

			.verse-share-picker select {
				width: 100%;
				min-width: 0;
				box-sizing: border-box;
				padding: 0.6rem 0.7rem;
				border: 1px solid rgb(38 38 38);
				border-radius: 0.5rem;
				background: rgba(10, 10, 10, 0.6);
				color: rgb(245 245 245);
				font-family: Georgia, Cambria, "Times New Roman", serif;
				font-size: 0.95rem;
			}

			.verse-share-modes {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
				gap: 0.75rem;
			}

			/* A group title hugs the buttons below it, the way "Choose a work" hugs its select. */
			.verse-share-picker + .verse-share-links-title,
			.verse-share-modes + .verse-share-links-title {
				margin-top: 0.85rem;
			}

			.verse-share-mode {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				min-width: 0;
				padding: 0.85rem 0.95rem;
				cursor: pointer;
				text-align: left;
				font-family: inherit;
				font-size: 0.95rem;
				transition: border-color 150ms ease, background-color 150ms ease;
			}

			.verse-share-mode:hover:not(:disabled) {
				border-color: rgb(82 82 82);
			}

			.verse-share-mode:disabled {
				cursor: not-allowed;
				opacity: 0.5;
			}

			.verse-share-mode:focus-visible {
				outline: none;
				box-shadow: 0 0 0 2px rgb(168 85 247);
			}

			.verse-share-mode p {
				overflow-wrap: anywhere;
			}

			.verse-share-link-hint {
				margin: 0.5rem 0 0;
				font-size: 0.7rem;
				color: rgb(115 115 115);
			}

			.verse-share-status {
				min-height: 1.2rem;
				margin: 0.85rem 0 0;
				font-size: 0.7rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: rgb(168 85 247);
			}

			.verse-share-links {
				border-top: 1px solid rgb(38 38 38);
				margin-top: 1.1rem;
				padding-top: 0.9rem;
			}

			.verse-share-links-title {
				font-size: 0.62rem;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: rgb(115 115 115);
				margin: 0 0 0.7rem;
			}

			.verse-share-link-buttons {
				display: flex;
				gap: 0.4rem;
				margin-left: auto;
				flex: none;
			}

			.verse-share-link-copy,
			.verse-share-link-revoke {
				flex: none;
				min-height: 2.25rem;
				border-radius: 0.375rem;
				font-size: 0.68rem;
				padding: 0.35rem 0.6rem;
				cursor: pointer;
			}

			.verse-share-link-copy {
				border: 1px solid rgb(63 63 70);
				background: transparent;
				color: rgb(212 212 212);
			}

			.verse-share-link-copy:hover:not(:disabled) { background: rgb(38 38 38); }

			.verse-share-links-empty {
				font-size: 0.78rem;
				color: rgb(115 115 115);
				margin: 0;
			}

			.verse-share-link-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				padding: 0.55rem 0;
				border-bottom: 1px solid rgb(32 32 32);
			}

			/* Ended rows remain for the record but recede visually; the state is in the text. */
			.verse-share-link-row-ended p,
			.verse-share-link-row-ended small {
				color: rgb(115 115 115);
			}

			.verse-share-links-note {
				font-size: 0.72rem;
				line-height: 1.5;
				color: rgb(115 115 115);
				margin: 0 0 0.45rem;
			}

			.verse-share-link-row p {
				font-size: 0.78rem;
				line-height: 1.5;
				color: rgb(212 212 212);
				overflow-wrap: anywhere;
			}

			.verse-share-link-row small {
				display: block;
				font-size: 0.68rem;
				color: rgb(115 115 115);
			}

			.verse-share-link-revoke {
				flex: none;
				border: 1px solid rgb(69 10 10);
				border-radius: 0.375rem;
				background: transparent;
				color: rgb(252 165 165);
				font-size: 0.68rem;
				padding: 0.35rem 0.6rem;
				cursor: pointer;
			}

			.verse-share-link-revoke:hover:not(:disabled) { background: rgba(69, 10, 10, 0.35); }
			.verse-share-link-revoke:disabled { cursor: not-allowed; opacity: 0.4; }

			.verse-share-private-hint {
				margin: 0.5rem 0 0;
				font-size: 0.7rem;
				line-height: 1.6;
				color: rgb(115 115 115);
			}

			.verse-share-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				padding-top: 0.9rem;
			}

			@media (max-width: 1023px) {
				.verse-share-modes {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 639px) {
				.verse-share-panel {
					padding: 1rem;
				}

				.verse-share-actions > * {
					width: 100%;
				}
			}
		</style>
		<section
			class="verse-share-panel verse-panel"
			data-public-address-configured={ fmt.Sprintf("%t", publicAddressConfigured) }
		>
			@CSRFField(ctx)
			<p class="verse-eyebrow">Share</p>
			<div class="verse-share-picker">
				<label for="share-work-picker">Choose a work</label>
				<select id="share-work-picker" name="work">
					if len(works) == 0 {
						<option value="">No works yet</option>
					} else {
						for _, work := range works {
							<option value={ work.ID } data-published={ publishedAttr(work.Published) }>{ work.Title }</option>
						}
					}
				</select>
			</div>
			<p class="verse-share-links-title">Copy</p>
			<div class="verse-share-modes" role="group" aria-label="Copy">
				<button type="button" data-share-action="text" class="verse-share-mode verse-panel-soft">
					<p class="font-serif text-[1rem] leading-snug text-neutral-100">Copy Text</p>
				</button>
				<button type="button" data-share-action="card" class="verse-share-mode verse-panel-soft">
					<p class="font-serif text-[1rem] leading-snug text-neutral-100">Card Export</p>
				</button>
			</div>
			<p class="verse-share-links-title">Link</p>
			<div class="verse-share-modes" role="group" aria-label="Link">
				<button type="button" data-share-action="link" class="verse-share-mode verse-panel-soft">
					<p class="font-serif text-[1rem] leading-snug text-neutral-100">Copy Link</p>
				</button>
				<button type="button" data-share-action="private" class="verse-share-mode verse-panel-soft">
					<p class="font-serif text-[1rem] leading-snug text-neutral-100">Private Link</p>
				</button>
				<button type="button" data-share-action="public" class="verse-share-mode verse-panel-soft">
					<p class="font-serif text-[1rem] leading-snug text-neutral-100">Public Link</p>
				</button>
			</div>
			<p class="verse-share-link-hint" hidden>Publish this work first to copy its public link.</p>
			<p class="verse-share-private-hint">
				A private link opens a temporary editor for just this work. The reader's changes come
				back as suggestions in its history, and the link expires in eight hours.
			</p>
			<p class="verse-share-private-hint">
				A public link lets anyone send a suggestion for a published work. Every submission is
				kept and reviewed in the work's history; it is never applied automatically.
			</p>
			<div class="verse-share-links" data-links hidden>
				<p class="verse-share-links-title">Links</p>
				<p class="verse-share-links-note">
					Ended links stay listed for the record, last in each group. Revoke is hidden once a
					link ends; New (private) or Rotate (public) issues a fresh one.
				</p>
				<div data-private-link-list></div>
				<div data-public-link-list></div>
			</div>
			<p class="verse-share-status" role="status" aria-live="polite"></p>
			<div class="verse-share-actions">
				<button
					hx-get="/library"
					hx-target="#screen"
					hx-swap="innerHTML"
					class="verse-button-secondary"
				>
					Open Library
				</button>
				<button
					hx-get="/editor"
					hx-target="#screen"
					hx-swap="innerHTML"
					class="verse-button-ghost"
				>
					Write Again
				</button>
			</div>
		</section>
	</div>
}

// publishedAttr is the picker option's flag for whether the work has a public address.
func publishedAttr(published bool) string {
	if published {
		return "true"
	}
	return "false"
}
