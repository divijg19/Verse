{
  "name": "verse",
  "type": "module",
  "private": true,
  "scripts": {
    "fmt:go": "golangci-lint fmt --diff",
    "templ": "templ generate",
    "vet": "go vet ./...",
    "lint": "golangci-lint run ./...",
    "staticcheck": "staticcheck ./cmd/... ./internal/... ./templ/... ./tests/...",
    "vuln": "govulncheck ./...",
    "dev": "bun scripts/dev.ts all",
    "dev:author": "bun scripts/dev.ts author",
    "dev:public": "bun scripts/dev.ts public",
    "dev:setup": "bun scripts/dev.ts setup",
    "build": "go build ./...",
    "qa": "bun fmt --check && bun check && bun fmt:go && bun vet && bun lint && bun staticcheck && bun test:scripts && bun vuln && bun run test",
    "test": "go test ./... -count=1 -race",
    "test:scripts": "bun test scripts/"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "tailwindcss": "^4.3.5"
  }
}
